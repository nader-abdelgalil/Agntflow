# PostgreSQL Configuration
POSTGRES_HOST=your_postgres_host_here
POSTGRES_USER=your_database_user_here
POSTGRES_PASSWORD=StrongSecurePassword123!
POSTGRES_DB=your_database_name_here
POSTGRES_PORT=your_postgres_port_here

# MCP Server Configuration
MCP_SERVER_PORT=your_mcp_server_port_here
MCP_API_KEY=your_mcp_secret_api_key_here

# n8n Configuration
N8N_PORT=your_n8n_port_here
N8N_ENCRYPTION_KEY=your_random_long_encryption_key_here
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_token_here